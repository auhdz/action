// Base settings. Copy `Secrets.example.xcconfig` to `Secrets.xcconfig` and fill in values (Secrets.xcconfig is gitignored).
#include? "Secrets.xcconfig"

PRODUCT_NAME = Action
PRODUCT_BUNDLE_IDENTIFIER = com.action.Action
MARKETING_VERSION = 1.0
CURRENT_PROJECT_VERSION = 1

IPHONEOS_DEPLOYMENT_TARGET = 17.0
SUPPORTED_PLATFORMS = iphoneos iphonesimulator
TARGETED_DEVICE_FAMILY = 1

// Injected into Info.plist; overridden by Secrets.xcconfig when present.
SUPABASE_URL =
SUPABASE_ANON_KEY =
